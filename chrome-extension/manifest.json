{
  "manifest_version": 3,
  "name": "Classroom Activity Monitor",
  "version": "2.0.0",
  "description": "Monitors student engagement during Google Meet classes. Reports attendance, focus, and chat activity to the professor dashboard via Firebase Realtime Database.",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "notifications",
    "storage",
    "windows"
  ],

  "host_permissions": [
    "https://meet.google.com/*",
    "https://kuwago-d6c14-default-rtdb.asia-southeast1.firebasedatabase.app/*",
    "https://identitytoolkit.googleapis.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["overlay.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Classroom Monitor"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
