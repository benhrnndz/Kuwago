{
  "manifest_version": 3,
  "name": "Classroom Activity Monitor",
  "version": "1.0.0",
  "description": "Monitors student engagement during Google Meet classes. Reports attendance, focus, and chat activity to the professor dashboard.",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "notifications",
    "storage"
  ],

  "host_permissions": [
    "https://meet.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["overlay.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Classroom Monitor"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
